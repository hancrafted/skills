{
  "name": "skills",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "knip": "knip",
    "prepare": "husky",
    "lint": "eslint . && npm run lint:boundaries",
    "lint:boundaries": "depcruise skills tools",
    "typecheck": "tsc --noEmit",
    "archgate:full": "archgate check --base $(git rev-list --max-parents=0 HEAD)",
    "verify": "node tools/verify/verify.ts",
    "verify:commit": "node tools/verify/verify.ts commit",
    "lint-staged": "lint-staged",
    "test:slow": "vitest run --config vitest.slow.config.mts",
    "check:docs": "npm run check:skills",
    "check:skills": "mh check --root skills --config skills/markdown-harness.config.yaml && for c in skills/*/markdown-harness.config.yaml; do test ! -e \"$c\" || mh check --root \"$(dirname \"$c\")\" --config \"$c\" || exit 1; done"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@hancrafted/markdown-harness": "~0.0.6",
    "@playwright/test": "~1.64.1",
    "@types/node": "~26.1.2",
    "@vitest/coverage-v8": "~4.1.10",
    "cheerio": "~1.2.0",
    "dependency-cruiser": "~18.5.0",
    "eslint": "~10.8.0",
    "eslint-config-prettier": "~10.1.8",
    "husky": "~9.1.7",
    "knip": "~6.31.0",
    "lint-staged": "~17.3.0",
    "prettier": "~3.9.6",
    "prettier-plugin-organize-imports": "~4.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.66.0",
    "vitest": "~4.1.10"
  }
}
