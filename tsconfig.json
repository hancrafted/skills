{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "skills/*/scripts/**/*.ts",
    "skills/*/evals/**/*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts",
    ".archgate/**/*.ts",
    "*.ts",
    "*.mts"
  ],
  "exclude": ["node_modules", ".worktrees", ".agents", ".claude"]
}
